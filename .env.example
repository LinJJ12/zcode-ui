# 可选：自行部署或对接后端时填写。壳预览默认不读取这些地址。
# 请勿把真实密钥写入仓库；本地覆盖可用未跟踪的 .env.local。
#
# 填写官方或第三方线上地址会产生对外请求，合规与配额由配置者负责。

ZCODE_BASE_URL=
BIGMODEL_API_BASE_URL=
ZAI_OAUTH_ORIGIN=
ZAI_BUSINESS_BASE_URL=
# OAuth client id 一般为公开标识，仍请使用你自己申请的值，勿假设可共用他人应用。
ZAI_OAUTH_CLIENT_ID=
ZCODE_CDN_BASE_URL=

ZCODE_CONVERSATION_SHARE_WEB_URL=
ZCODE_REMOTE_ASSET_CDN_BASE_URL=

# 可选本地 Provider 配置；留空则使用包内默认/内置配置（若有）。
ZCODE_BUILTIN_PROVIDER_CONFIG_FILE=

ZCODE_DEPS_BASE_URL=
INTRANET_MACHINE_HOST=
ZCODE_DIST_BASE_URL=
