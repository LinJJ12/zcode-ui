{
  "name": "zcode-ui-shell",
  "version": "3.15.1",
  "private": true,
  "description": "Frontend source from ZCode, kept locally so later projects can reference the UI",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @zcode/web dev",
    "dev:web": "pnpm --filter @zcode/web dev",
    "build": "pnpm --filter @zcode/web build",
    "build:web": "pnpm --filter @zcode/web build",
    "typecheck": "tsc -b packages/rpc packages/provider packages/provider-node packages/shared packages/services packages/ui packages/web",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix --fix-suggestions",
    "clean": "node scripts/clean.mjs",
    "ci:assert-node": "node scripts/assert-node-version.mjs"
  },
  "dependencies": {
    "border-beam": "^1.0.1",
    "d3-path": "^3.1.0",
    "tailwind-scrollbar-hide": "^4.0.0"
  },
  "devDependencies": {
    "@jridgewell/trace-mapping": "0.3.31",
    "@tanstack/react-virtual": "^3.13.23",
    "@types/node": "^25.5.0",
    "concurrently": "^9.1.2",
    "dotenv": "^17.4.2",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.57.0",
    "tsx": "^4.19.4",
    "typescript": "^6.0.2",
    "vitest": "^4.1.1"
  },
  "peerDependencies": {
    "@tanstack/react-virtual": "^3.13.23"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "overrides": {
      "react": "19.2.7",
      "react-dom": "19.2.7"
    },
    "patchedDependencies": {
      "vitest@4.1.7": "patches/vitest@4.1.7.patch"
    }
  },
  "license": "Apache-2.0"
}
